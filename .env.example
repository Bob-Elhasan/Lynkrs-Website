# Absolute origin used for canonical links and Open Graph tags.
# Defaults to the GitHub Pages project URL.
VITE_SITE_URL=https://bob-elhasan.github.io/Lynkrs-Website

# Vite base path. Change to "/" if you move to a custom domain.
VITE_BASE=/Lynkrs-Website/

# Where the lead form POSTs. Leave blank and the form falls back to a
# mailto: handoff so an enquiry is never silently dropped.
VITE_CONTACT_ENDPOINT=
